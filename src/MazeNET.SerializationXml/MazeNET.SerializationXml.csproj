<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0;net9.0;net10.0;netstandard2.0;netstandard2.1</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>2.0.2</Version>
    <Authors>Duy Khanh</Authors>
    <Product>MazeNET.SerializationXml</Product>
    <Description>.NET XML Serialization Helper - Clean Architecture with multi-targeting support for .NET Framework 4.8, .NET 8, .NET 9, and .NET 10</Description>
    <Copyright>Duy Khanh</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>.NET XML Serialization, XML Serialization, .NET Framework 4.8, .NET 8, .NET 9, .NET 10, Clean Architecture</PackageTags>
    <PackageIcon>Logo.png</PackageIcon>
    <PackageIconUrl />
    <ApplicationIcon>Logo.ico</ApplicationIcon>
    <PackageProjectUrl>https://codemaze.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/khanhnd157/SerializationXml</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>v2.0.2 - Restructured with Clean Architecture, new namespace MazeNET.SerializationXml, added multi-targeting support for .NET Framework 4.8, .NET 8, .NET 9, and .NET 10</PackageReleaseNotes>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <WarningLevel>4</WarningLevel>
    <RootNamespace>MazeNET.SerializationXml</RootNamespace>
    <AssemblyName>MazeNET.SerializationXml</AssemblyName>
    <PackageId>MazeNET.SerializationXml</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyVersion>2.0.2.125</AssemblyVersion>
    <FileVersion>2.0.2.125</FileVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- .NET Framework 4.8 specific configuration -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <!-- .NET 8+ specific configuration -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net9.0' OR '$(TargetFramework)' == 'net10.0'">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="Assets\Logo.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
